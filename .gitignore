# ARCHIVOS GENERADOS POR LA APLICACIÓN
# =============================================================================

# Historias generadas por la aplicación
historia_*.txt
historias_generadas/
output/
resultados/

# Logs de la aplicación
*.log
logs/

# =============================================================================
