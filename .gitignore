# ARCHIVOS DEL SISTEMA OPERATIVO
# =============================================================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# EDITORES E IDEs
# =============================================================================

# Visual Studio Code
.vscode/
*.swp
*.swo

# PyCharm
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
